# --- Core ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
# SQLite by default (zero setup). Swap for a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cruxgpt
DATABASE_URL=sqlite+aiosqlite:///./data/crux.db

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / Embeddings (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=
# Updated to the latest fast Flash model
GEMINI_LLM_MODEL=gemini-3.6-flash
# Updated to the newest unified embedding model
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Supabase Storage ---
# Create the cruxgpt-documents bucket as PRIVATE before deploying.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=cruxgpt-documents

# --- Chunking ---
CHUNK_SIZE_CHARS=3000
CHUNK_OVERLAP_CHARS=400

# --- Retrieval ---
RETRIEVAL_TOP_K=6
